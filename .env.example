# For direct messaging across countries set the same MONGO_URI and MONGO_DB on both laptops.
# MongoDB mode starts only the desktop client; no WebSocket server is needed.
# MESSENGER_TRANSPORT=websocket forces the optional server-based mode.
HOST=localhost
PORT=8765
MESSENGER_SERVER_URL=ws://localhost:8765

# Leave MONGO_URI empty to store data in DATA_FILE.
MONGO_URI=
DATA_FILE=server_data.json

# Used only when MONGO_URI is configured.
MONGO_DB=Messenger
MONGO_COLLECTION_USERS=users_login
MONGO_COLLECTION_MESSAGES=messages
